// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  avatarUrl String?  @map("avatar_url")
  title     String
  score     Int      @default(0)
  winRate   Int      @default(0) @map("win_rate")
  createdAt DateTime @default(now()) @map("created_at")

  photoEntries PhotoEntry[]
  votes Vote[]

  @@map("Users")
}

enum TournamentStatus {
  active
  voting
  closed
}

model Tournament {
  id  String  @id @default(uuid())
  title String
  description String  @db.Text
  status  TournamentStatus
  coverImageUrl String  @map("cover_image_url")
  createdAt DateTime  @default(now()) @map("created_at")
  endDate DateTime  @map("end_date")

  photoEntries PhotoEntry[]
  votes Vote[]

  @@map("Tournaments")
}

model PhotoEntry {
  id  String  @id @default(uuid())
  tournamentId  String  @map("tournament_id")
  authorId  String  @map("author_id")
  imageUrl  String  @map("image_url")
  votes Int @default(0)
  submittedAt DateTime  @default(now()) @map("submitted_at")

  tournament  Tournament  @relation(fields: [tournamentId], references: [id])
  author  User  @relation(fields: [authorId], references: [id])

  wonVotes Vote[] @relation("WinnerVotes")
  lostVotes Vote[] @relation("LoserVotes")

  @@map("PhotoEntries")
}

model Vote {
  id  String  @id @default(uuid())
  tournamentId  String  @map("tournament_id")
  winnerEntryId String  @map("winner_entry_id")
  loserEntryId  String  @map("loser_entry_id")
  voterId String  @map("voter_id")
  createdAt DateTime  @default(now()) @map("created_at")

  tournament  Tournament  @relation(fields: [tournamentId], references: [id])
  voter User  @relation(fields: [voterId], references: [id])

  winnerEntry PhotoEntry  @relation("WinnerVotes", fields: [winnerEntryId], references: [id])
  loserEntry  PhotoEntry  @relation("LoserVotes", fields: [loserEntryId], references: [id])

  @@unique([voterId, winnerEntryId, loserEntryId])

  @@map("Votes")
}
